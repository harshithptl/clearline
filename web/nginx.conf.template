# Serves the dashboard and proxies /api/* to the services, so the browser
# only ever talks to one origin (no CORS). Rendered by the nginx image's
# envsubst step from /etc/nginx/templates at container start.
#
# The public demo (Phase 4) uses a variant without the /api/gateway block:
# no write endpoint is reachable, and the UI hides the order form.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    # Locations below add Cache-Control; merge keeps these headers too
    # (without it, any add_header in a location drops the server's).
    add_header_inherit merge;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" always;

    # Hashed build assets never change: cache for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }

    # Server-Sent Events: no buffering, long read timeout, no compression.
    location = /api/balance/events {
        proxy_pass http://${CLEARLINE_BALANCE_UPSTREAM}/events;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
    }

    location /api/balance/ {
        proxy_pass http://${CLEARLINE_BALANCE_UPSTREAM}/;
    }

    location /api/reconciler/ {
        proxy_pass http://${CLEARLINE_RECONCILER_UPSTREAM}/;
    }

    location /api/gateway/ {
        proxy_pass http://${CLEARLINE_GATEWAY_UPSTREAM}/;
        client_max_body_size 8k;
    }
}
